{
    "class_": "TheCausalityGame.core.contracts.problem_instance:ProblemInstance",
    "id": "test_problem_instance",
    "schema_version": "0.1.0",
    "agents": [
        {
            "class_": "TheCausalityGame.agent.exhaustive:ExhaustiveAgent",
            "params": {
                "num_obs": 10,
                "num_inter": 10
            },
            "id": "Exhaustive"
        }
    ],
    "scm": {
    "class_": "TheCausalityGame.scm.core:CoreSCM",
    "vars": [
        {
            "class_": "TheCausalityGame.scm.nodes.sympy:EquationBasedNumericalSCMNode",
            "name": "V",
            "domain": [-10e10, 10e10],
            "accessibility": "controllable"
        },
        {
            "class_": "TheCausalityGame.scm.nodes.sympy:EquationBasedNumericalSCMNode",
            "name": "R",
            "domain": [0.1, 10e10],
            "accessibility": "controllable"
        },
        {
            "class_": "TheCausalityGame.scm.nodes.sympy:EquationBasedNumericalSCMNode",
            "name": "C",
            "domain": [0.1, 10e10],
            "accessibility": "controllable"
        },
        {
            "class_": "TheCausalityGame.scm.nodes.sympy:EquationBasedNumericalSCMNode",
            "name": "q",
            "domain": [-10e10, 10e10],
            "accessibility": "controllable"
        },
        {
            "class_": "TheCausalityGame.scm.nodes.sympy:EquationBasedNumericalSCMNode",
            "name": "Vc",
            "domain": [-10e10, 10e10],
            "equation": "q/C"
        },
        {
            "class_": "TheCausalityGame.scm.nodes.sympy:EquationBasedNumericalSCMNode",
            "name": "I",
            "domain": [-10e10, 10e10],
            "equation": "(V - Vc)/R"
        }
    ],
    "dag": {
        "class_": "TheCausalityGame.scm.dag.core:CoreDAG",
        "edges": [["C", "Vc"], ["q", "Vc"], ["V", "I"], ["Vc", "I"], ["R", "I"]]
    }
},
    "mission": {
        "class_": "TheCausalityGame.mission.dag_discovery:DAGDiscoveryMission",
        "id": "dag_discovery_mission",
        "behavior_metric": {
            "class_": "TheCausalityGame.metric.behavior.resource_usage:ResourceUsageBehaviorMetric"
        },
        "result_metric": {
            "class_": "TheCausalityGame.metric.result.shd:SHDResultMetric"
        },
        "result_validator": {
            "class_": "TheCausalityGame.metric.result.result_validator.dag_validator:DAGResultValidator"
        }
    },
    "custom_metrics": [],
    "run_plan": {
        "execution": "parallel",
        "parallel_backend": "thread",
        "budget": {
            "rounds": 10000,
            "time_s": 1500,
            "samples": 10000000,
            "memory_mb": 1024
        },
        "hook_plan": [
            {
                "class_": "TheCausalityGame.hook.plots.agent_comparison_plot:AgentsComparisonPlotHook",
                "step": "benchmark_end"
            },
            {
                "class_": "TheCausalityGame.hook.plots.final_dag_per_agent:FinalDAGPerAgent",
                "step": "benchmark_end"
            }
        ]
    },
    "seeds": {
        "agent": 42,
        "scm": 911,
        "misc": 7
    },
    "runtime": {
        "mode": "dev",
        "debug_level": 10
    }
}