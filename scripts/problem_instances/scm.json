{
    "class_": "TheCausalityGame.core.contracts.problem_instance:ProblemInstance",
    "id": "test_problem_instance",
    "schema_version": "0.1.0",
    "agents": [
        {
            "class_": "TheCausalityGame.agent.exhaustive:ExhaustiveAgent",
            "params": {
                "num_obs": 10,
                "num_inter": 10
            },
            "id": "Exhaustive"
        }
    ],
    "scm": {
    "class_": "TheCausalityGame.scm.core:CoreSCM",
    "vars": [
        {
            "class_": "TheCausalityGame.scm.nodes.sympy:EquationBasedNumericalSCMNode",
            "name": "m",
            "domain": [0, 1e11]
        },
        {
            "class_": "TheCausalityGame.scm.nodes.sympy:EquationBasedNumericalSCMNode",
            "name": "a",
            "domain": [-1e11, 1e11]
        },
        {
            "class_": "TheCausalityGame.scm.nodes.sympy:EquationBasedNumericalSCMNode",
            "name": "F",
            "equation": "a*m",
            "domain": [-1e11, 1e23]
        }
    ],
    "dag": {
        "class_": "TheCausalityGame.scm.dag.core:CoreDAG",
        "edges": [["m", "F"], ["a", "F"]]
    }
},
    "mission": {
        "class_": "TheCausalityGame.mission.scm_estimation:SCMEstimationMission",
        "id": "scm_estimation_mission",
        "behavior_metric": {
            "class_": "TheCausalityGame.metric.behavior.resource_usage:ResourceUsageBehaviorMetric"
        },
        "result_metric": {
            "class_": "TheCausalityGame.metric.result.scm_combined_score:SCMCombinedScoreResultMetric"
        },
        "result_validator": {
            "class_": "TheCausalityGame.metric.result.result_validator.scm_validator:SCMResultValidator"
        }
    },
    "custom_metrics": [],
    "run_plan": {
        "execution": "parallel",
        "parallel_backend": "thread",
        "budget": {
            "rounds": 1000,
            "time_s": 1500,
            "samples": 10000000,
            "memory_mb": 1024
        },
        "hook_plan": [
            {
                "class_": "TheCausalityGame.hook.plots.agent_comparison_plot:AgentsComparisonPlotHook",
                "step": "benchmark_end"
            }
        ]
    },
    "seeds": {
        "agent": 42,
        "scm": 911,
        "misc": 7
    },
    "runtime": {
        "mode": "dev",
        "debug_level": 10
    }
}