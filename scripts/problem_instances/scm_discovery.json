        {
            "class_": "TheCausalityGame.agent.annadani:Annadani2024CAASLOnlineAgent",
            "id": "Annadani2024CAASLOnline"
        },
        {
            "class_": "TheCausalityGame.agent.geng:HeGeng2008MinimaxAgent",
            "id": "HeGeng2008Minimax"
