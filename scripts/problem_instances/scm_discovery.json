            "class_": "TheCausalityGame.agent.exhaustive:ExhaustiveAgent",
            "id": "Exhaustive"
        },
        {
            "class_": "TheCausalityGame.agent.random:RandomAgent",
            "id": "Random"
        },
        {
            "class_": "TheCausalityGame.agent.cho:Cho2016ActiveGBNAgent",
            "id": "Cho2016ActiveGBN"
        },
        {
            "class_": "TheCausalityGame.agent.tigas:Tigas2022CBEDAgent",
            "id": "Tigas2022CBED"
