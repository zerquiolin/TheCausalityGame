        {
            "class_": "TheCausalityGame.agent.gies:GIESAgent",
            "id": "GIES"
        }
    ],
    "scm": {
        "class_": "TheCausalityGame.scm.core:CoreSCM",
        "vars": [
            {
                "class_": "TheCausalityGame.scm.nodes.sympy:EquationBasedNumericalSCMNode",
                "name": "V",
                "domain": [
                    -10e10,
                    10e10
                ],
                "accessibility": "controllable"
            },
            {
                "class_": "TheCausalityGame.scm.nodes.sympy:EquationBasedNumericalSCMNode",
                "name": "R",
                "domain": [
                    0.1,
                    10e10
                ],
                "accessibility": "controllable"
            },
            {
                "class_": "TheCausalityGame.scm.nodes.sympy:EquationBasedNumericalSCMNode",
                "name": "C",
                "domain": [
                    0.1,
                    10e10
                ],
                "accessibility": "controllable"
            },
            {
                "class_": "TheCausalityGame.scm.nodes.sympy:EquationBasedNumericalSCMNode",
                "name": "q",
                "domain": [
                    -10e10,
                    10e10
                ],
                "accessibility": "controllable"
            },
            {
                "class_": "TheCausalityGame.scm.nodes.sympy:EquationBasedNumericalSCMNode",
                "name": "Vc",
                "domain": [
                    -10e10,
                    10e10
                ],
                "equation": "q/C"
            },
            {
                "class_": "TheCausalityGame.scm.nodes.sympy:EquationBasedNumericalSCMNode",
                "name": "I",
                "domain": [
                    -10e10,
                    10e10
                ],
                "equation": "(V - Vc)/R"
            }
        ],
        "dag": {
            "class_": "TheCausalityGame.scm.dag.core:CoreDAG",
            "edges": [
                [
                    "C",
                    "Vc"
                ],
                [
                    "q",
                    "Vc"
                ],
                [
                    "V",
                    "I"
                ],
                [
                    "Vc",
                    "I"
                ],
                [
                    "R",
                    "I"
                ]
            ]
        }
    },
    "mission": {
        "class_": "TheCausalityGame.mission.scm_estimation:SCMEstimationMission",
        "id": "scm_estimation_mission",
        "behavior_metric": {
            "class_": "TheCausalityGame.metric.behavior.available_resources:AvailableResourcesBehaviorMetric"
        },
