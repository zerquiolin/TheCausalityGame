            "class_": "TheCausalityGame.agent.exhaustive:ExhaustiveAgent",
            "id": "Exhaustive"
        },
        {
            "class_": "TheCausalityGame.agent.random:RandomAgent",
            "id": "Random"
        },
        {
            "class_": "TheCausalityGame.agent.cho:Cho2016ActiveGBNAgent",
            "id": "Cho2016ActiveGBN"
        },
        {
            "class_": "TheCausalityGame.agent.tigas:Tigas2022CBEDAgent",
            "id": "Tigas2022CBED"
        },
        {
            "class_": "TheCausalityGame.agent.annadani:Annadani2024CAASLOnlineAgent",
            "id": "Annadani2024CAASLOnline"
        },
        {
            "class_": "TheCausalityGame.agent.geng:HeGeng2008MinimaxAgent",
            "id": "HeGeng2008Minimax"
        },
        {
            "class_": "TheCausalityGame.agent.gies:GIESAgent",
            "id": "GIES"
        }
    ],
    "scm": {
        "class_": "TheCausalityGame.scm.core:CoreSCM",
    "vars": [
        {
            "class_": "TheCausalityGame.scm.nodes.sympy:EquationBasedNumericalSCMNode",
            "name": "V",
            "domain": [-10e10, 10e10]
        },
        {
            "class_": "TheCausalityGame.scm.nodes.sympy:EquationBasedNumericalSCMNode",
            "name": "R",
            "domain": [1e-3, 10e10]
        },
        {
            "class_": "TheCausalityGame.scm.nodes.sympy:EquationBasedNumericalSCMNode",
            "name": "C",
            "domain": [1e-6, 10e10]
        },
        {
            "class_": "TheCausalityGame.scm.nodes.sympy:EquationBasedNumericalSCMNode",
            "name": "q",
            "domain": [-10e10, 10e10]
        },
        {
            "class_": "TheCausalityGame.scm.nodes.sympy:EquationBasedNumericalSCMNode",
            "name": "Vc",
            "domain": [-10e10, 10e10],
            "equation": "q/C"
        },
        {
            "class_": "TheCausalityGame.scm.nodes.sympy:EquationBasedNumericalSCMNode",
            "name": "I",
            "domain": [-10e10, 10e10],
            "equation": "(V - Vc)/R"
        }
    ],
    "dag": {
        "class_": "TheCausalityGame.scm.dag.core:CoreDAG",
        "edges": [["C", "Vc"], ["q", "Vc"], ["V", "I"], ["Vc", "I"], ["R", "I"]]
    }
    },
    "mission": {
        "class_": "TheCausalityGame.mission.scm_estimation:SCMEstimationMission",
        "id": "scm_estimation_mission",
        "behavior_metric": {
            "class_": "TheCausalityGame.metric.behavior.resource_usage:ResourceUsageBehaviorMetric"
        },
        "result_metric": {
