        },
        "result_validator": {
            "class_": "TheCausalityGame.metric.result.result_validator.scm_validator:SCMResultValidator"
        }
    },
    "custom_metrics": [],
    "run_plan": {
        "execution": "parallel",
        "parallel_backend": "thread",
        "budget": {
            "rounds": 175,
            "time_s": 3950,
            "samples": 5700,
            "memory_mb": 1
        },
        "hook_plan": [
            {
                "class_": "TheCausalityGame.hook.plots.agent_comparison_plot:AgentsComparisonPlotHook",
                "step": "benchmark_end"
            },
            {
                "class_": "TheCausalityGame.hook.plots.final_dag_per_agent:FinalDAGPerAgent",
                "step": "benchmark_end"
            }
        ]
    },
    "seeds": {
        "agent": 42,
        "scm": 911,
        "misc": 7
