{
    "class_": "TheCausalityGame.core.contracts.problem_instance:ProblemInstance",
    "id": "test_problem_instance",
    "schema_version": "0.1.0",
    "agents": [
        {
            "class_": "TheCausalityGame.agent.exhaustive:ExhaustiveAgent",
            "params": {
                "num_obs": 2,
                "num_inter": 2
            },
            "id": "Exhaustive"
        },
        {
            "class_": "TheCausalityGame.agent.random_agent:RandomAgent",
            "params": {
                "num_obs": 2,
                "num_inter": 2
            },
            "id": "Random"
        },
        {
            "class_": "TheCausalityGame.agent.intelligent_agent:IntelligentAgent",
            "params": {
                "num_obs": 2,
                "num_inter": 2,
                "exploration_weight": 1.5
            },
            "id": "Intelligent"
        },
        {
            "class_": "TheCausalityGame.agent.reinforcement_learning_agent:ReinforcementLearningAgent",
            "params": {
                "num_obs": 2,
                "num_inter": 2,
                "epsilon": 0.1
            },
            "id": "Reinforcement Learning"
        }
    ],
    "scm": {
        "class_": "TheCausalityGame.scm.core:CoreSCM",
        "vars": [
            {
                "class_": "TheCausalityGame.scm.nodes.bn:BayesianNetworkSCMNode",
                "name": "Z",
                "accessibility": "controllable",
                "domain": [
                    "0",
                    "1"
                ],
                "probability_distribution": [
                    0.5,
                    0.5
                ]
            },
            {
                "class_": "TheCausalityGame.scm.nodes.sympy:EquationBasedNumericalSCMNode",
                "name": "X",
                "accessibility": "measurable",
                "domain": [
                    0,
                    2
                ],
                "parents": [
                    "Z"
                ],
                "parent_mappings": {
                    "Z": {
                        "0": 0,
                        "1": 1
                    }
                },
                "equation": "2*Z"
            },
            {
                "class_": "TheCausalityGame.scm.nodes.sympy:EquationBasedNumericalSCMNode",
                "name": "Y",
                "accessibility": "measurable",
                "domain": [
                    0,
                    4
                ],
                "parents": [
                    "Z",
                    "X"
                ],
                "equation": "0.5*X + 3*Z"
            }
        ],
        "dag": {
            "class_": "TheCausalityGame.scm.dag.core:CoreDAG",
            "nodes": [
                "Z",
                "X",
                "Y"
            ],
            "edges": [
                [
                    "Z",
                    "X"
                ],
                [
                    "Z",
                    "Y"
                ],
                [
                    "X",
                    "Y"
                ]
            ]
        }
    },
    "mission": {
        "class_": "TheCausalityGame.mission.conditional_average_treatment_effect:ConditionalAverageTreatmentEffectMission",
        "id": "conditional_average_treatment_effect",
        "behavior_metric": {
            "class_": "TheCausalityGame.metric.behavior.resource_usage:ResourceUsageBehaviorMetric"
        },
        "result_metric": {
            "class_": "TheCausalityGame.metric.result.pehe:PEHEResultMetric"
        },
        "result_validator": {
            "class_": "TheCausalityGame.metric.result.result_validator.cate_function_validator:ConditionalAverageTreatmentEffectFunctionValidator"
        }
    },
    "custom_metrics": [],
    "run_plan": {
        "execution": "parallel",
        "parallel_backend": "thread",
        "budget": {
            "rounds": 1000,
            "time_s": 1500,
            "samples": 10000000,
            "memory_mb": 1024
        },
        "hook_plan": [
            {
                "class_": "TheCausalityGame.hook.plots.agent_comparison_plot:AgentsComparisonPlotHook",
                "step": "benchmark_end"
            }
        ]
    },
    "seeds": {
        "agent": 42,
        "scm": 911,
        "misc": 7
    },
    "runtime": {
        "mode": "dev",
        "debug_level": 10
    }
}