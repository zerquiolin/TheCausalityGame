\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{sa_notes}[2025/10/26 SA personal notes]

% -------- Options: [notes] (default) / [nonotes] -------------------
\newif\ifSA@notes
\SA@notestrue
\DeclareOption{notes}{\SA@notestrue}
\DeclareOption{nonotes}{\SA@notesfalse}
\DeclareOption*{} % ignore unknown options
\ProcessOptions\relax

% -------- Packages (load-time order) --------------------------------
% If you use hyperref, load it in the main doc BEFORE this package.
\ifSA@notes
  \RequirePackage[textsize=footnotesize,colorinlistoftodos]{todonotes}
\else
  \RequirePackage[disable]{todonotes}
\fi
\RequirePackage{xcolor}
\RequirePackage{xparse}
\RequirePackage{tikz}
\ifSA@notes
  \RequirePackage[skins]{tcolorbox}
\fi

% -------- Colors & initials -----------------------------------------
\definecolor{SAcyan}{RGB}{0,150,180}
\colorlet{SAlight}{SAcyan!45} % connector/anchor shade knob
\providecommand{\SAinitials}{SA} % user can \renewcommand before/after load

% -------- Margin width management (play nice with geometry) ----------
\newlength\SA@origmarginparwidth
\AtBeginDocument{\setlength{\SA@origmarginparwidth}{\marginparwidth}}
\ifSA@notes
  \AtBeginDocument{\setlength{\marginparwidth}{2.4cm}}
\else
  \AtBeginDocument{\setlength{\marginparwidth}{\SA@origmarginparwidth}}
\fi

% -------- Inline badge (in-text) ------------------------------------
\ifSA@notes
  \newtcbox{\sabadge}[1][]{%
    on line, tcbox raise base,
    colframe=SAcyan, colback=SAcyan!10, coltext=black,
    boxrule=0.4pt, arc=1.4pt,
    left=0.6ex, right=0.6ex, top=0.2ex, bottom=0.2ex,
    boxsep=0.3ex, #1
  }
\fi

% -------- Anchor underline + vertical pipe (matching color) ----------
% \saanchor[<underline len>][<line width>][<color>][<pipe up>][<pipe down>]
% defaults: 1.0em, 0.35pt, SAlight, 0.9ex, 0.6ex
\ifSA@notes
  \NewDocumentCommand{\saanchor}{O{1.0em} O{0.35pt} O{SAlight} O{0.9ex} O{0.6ex}}{%
    \rlap{%
      \tikz[baseline]{
        \draw[draw=#3, line width=#2, line cap=round] (0,-0.6ex) -- (#1,-0.6ex); % underline
        \draw[draw=#3, line width=#2, line cap=round] (0,-#5) -- (0,#4);         % vertical pipe
      }%
    }%
  }
\else
  \NewDocumentCommand{\saanchor}{O{1.0em} O{0.35pt} O{SAlight} O{0.9ex} O{0.6ex}}{}%
\fi

% -------- Main command: \sa{<text>}[<mode>]* ------------------------
% <mode>=0 (default): inline badge
% <mode>=1: margin bubble + straight subtle connector + anchor underline+pipe
% * (star)  : place at a paragraph break (connector in whitespace)
\ifSA@notes
  \NewDocumentCommand{\me}{m O{0} s}{%
    \IfBooleanTF{#3}{% STARRED: paragraph break placement
      \par\noindent
      \todo[
        linecolor=SAlight,
        bordercolor=SAcyan,
        backgroundcolor=SAcyan!10,
        tickmarkheight=0.08ex
      ]{\textbf{\SAinitials}:~#1}%
    }{%
      \ifnum#2=1\relax
        \saanchor
        \todo[
          linecolor=SAlight,              % straight subtle connector (no arrowheads)
          bordercolor=SAcyan,
          backgroundcolor=SAcyan!10,
          tickmarkheight=0.08ex
        ]{\textbf{\SAinitials}:~#1}%
      \else
        \sabadge{\textbf{\SAinitials}:~#1}%
      \fi
    }%
  }
\else
  \NewDocumentCommand{\me}{m O{0} s}{}%
\fi

\endinput