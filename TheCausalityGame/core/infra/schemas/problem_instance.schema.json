{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://tcg/schemas/problem_instance.schema.json",
    "type": "object",
    "required": [
        "schema_version",
        "id",
        "scm_spec",
        "mission_spec",
        "agent_specs",
        "metric_specs",
        "run_plan"
    ],
    "properties": {
        "schema_version": {
            "type": "string"
        },
        "id": {
            "type": "string"
        },
        "scm_spec": {
            "type": "object"
        },
        "mission_spec": {
            "type": "object"
        },
        "agent_specs": {
            "type": "array",
            "items": {
                "type": "object"
            },
            "minItems": 1
        },
        "metric_specs": {
            "type": "object",
            "required": [
                "behavior",
                "result"
            ],
            "properties": {
                "behavior": {
                    "type": "object",
                    "required": [
                        "id",
                        "class"
                    ],
                    "properties": {
                        "id": {
                            "type": "string"
                        },
                        "class": {
                            "type": "string"
                        },
                        "config": {
                            "type": "object",
                            "default": {}
                        }
                    },
                    "additionalProperties": false
                },
                "result": {
                    "type": "object",
                    "required": [
                        "id",
                        "class"
                    ],
                    "properties": {
                        "id": {
                            "type": "string"
                        },
                        "class": {
                            "type": "string"
                        },
                        "config": {
                            "type": "object",
                            "default": {}
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },
        "custom_metric_specs": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "class"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "class": {
                        "type": "string"
                    },
                    "config": {
                        "type": "object",
                        "default": {}
                    }
                },
                "additionalProperties": false
            },
            "default": []
        },
        "run_plan": {
            "type": "object",
            "required": [
                "rounds",
                "budgets"
            ],
            "properties": {
                "rounds": {
                    "type": "integer",
                    "minimum": 1
                },
                "execution": {
                    "type": "string",
                    "enum": [
                        "sequential",
                        "parallel"
                    ],
                    "default": "sequential"
                },
                "parallel_backend": {
                    "type": "string",
                    "enum": [
                        "thread",
                        "process"
                    ],
                    "default": "thread"
                },
                "max_workers": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 1,
                    "default": null
                },
                "budgets": {
                    "type": "object",
                    "properties": {
                        "time_s": {
                            "type": [
                                "number",
                                "null"
                            ],
                            "minimum": 0
                        },
                        "samples": {
                            "type": [
                                "integer",
                                "null"
                            ],
                            "minimum": 0
                        },
                        "memory_mb": {
                            "type": [
                                "integer",
                                "null"
                            ],
                            "minimum": 0
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },
        "seeds": {
            "type": "object",
            "default": {}
        },
        "hook_plan": {
            "type": "array",
            "items": {
                "type": "object"
            },
            "default": []
        },
        "artifacts_policy": {
            "type": "object",
            "default": {}
        }
    },
    "additionalProperties": false
}