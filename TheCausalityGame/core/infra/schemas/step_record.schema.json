{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
        "round_index",
        "step_index",
        "agent_id",
        "mission_id",
        "done"
    ],
    "properties": {
        "round_index": {
            "type": "integer",
            "minimum": 0
        },
        "step_index": {
            "type": "integer",
            "minimum": 0
        },
        "agent_id": {
            "type": "string"
        },
        "mission_id": {
            "type": "string"
        },
        "action": {
            "type": [
                "object",
                "null"
            ]
        },
        "observation": {
            "type": [
                "object",
                "null"
            ]
        },
        "done": {
            "type": "boolean"
        },
        "time_s": {
            "type": [
                "number",
                "null"
            ]
        },
        "error": {
            "type": [
                "string",
                "null"
            ]
        },
        "budgets_consumed": {
            "type": "object"
        }
    },
    "additionalProperties": false
}